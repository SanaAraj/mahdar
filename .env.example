# ---- Mahdar configuration ----
# Transcription and minutes extraction both run on one free Groq key by
# default. Create one at console.groq.com and copy it here into .env.
# Provider selectors: groq (cloud, needs GROQ_API_KEY) or local (offline,
# needs no key). Setting both to local runs the app fully offline.
STT_PROVIDER=groq
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_LLM_MODEL=openai/gpt-oss-120b
# ---- Local (offline) providers, used only when the selectors above = local ----
# Faster-whisper model, downloaded once to the data volume on first local run.
LOCAL_STT_MODEL=large-v3-turbo
# The Ollama model the compose "local" service pulls and serves.
LOCAL_LLM_MODEL=qwen3:8b
# Where the app reaches the local LLM; matches the compose service name.
OLLAMA_URL=http://ollama:11434/v1
# Speaker diarization (optional), a free read token from huggingface.co.
HF_TOKEN=
MAX_UPLOAD_MB=500
DATA_DIR=/data
# Phase B: at most 3 pipelines run at once; a 4th gets an Arabic 503.
MAX_ACTIVE_JOBS=3
# Phase B: per-route rate limits (429 + Arabic body). Set false for scripts.
RATE_LIMIT_ENABLED=true
# Empty = same-origin only behind Caddy. Set a comma-separated origin list to
# enable cross-origin browsers to call the API directly.
CORS_ORIGINS=
