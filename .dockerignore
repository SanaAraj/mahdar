.git
# Secrets never enter the build context. .env is mounted at runtime via
# docker-compose env_file; no env file or backup belongs in the image.
.env
.env.*
!.env.example
data/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
docs/
samples/
.dockerignore
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.turbo/
**/node_modules/
.venv/
apps/api/.venv/
apps/api/tests/
apps/web/.output/
apps/web/.nitro/
apps/web/.tanstack/
apps/web/src/routeTree.gen.ts
