# Secrets: ignore every env file and backup, then re-admit the example
# template. Anything holding a real key (.env, .env.backup, .env.local) must
# never enter git; only .env.example is committed.
.env
.env.*
!.env.example
# Runtime output: every meeting's audio, transcript, and state.json. Never
# enters git (matching .dockerignore); tracked here so a bare `git add -A`
# cannot sweep job artifacts into a commit.
data/
# Local working notes: root-level markdown stays out of git except the README.
# Shipped documentation lives in docs/.
/*.md
!/README.md
samples/external/
.venv/
__pycache__/
.ruff_cache/
.pytest_cache/
*.pyc
.DS_Store
